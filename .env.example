PORT=3000

# Local Docker defaults
APP_PORT=3000
APP2_PORT=3001
APP3_PORT=3002
LOCALSTACK_PORT=4566
POSTGRES_PASSWORD=local-admin
APP_DATABASE_PASSWORD=local-app
MIGRATION_DATABASE_PASSWORD=local-migrator

# Dev mode database (local `bun start`)
DATABASE_URL=postgresql://wager_app:local-app@localhost:5432/wagering
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_TRANSACTION_TIMEOUT_MS=5000
DATABASE_TRANSACTION_MAX_ATTEMPTS=3
DATABASE_RETRY_BASE_DELAY_MS=25
DATABASE_RETRY_MAX_DELAY_MS=250
