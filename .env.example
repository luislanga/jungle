PORT=3000

# Local Docker defaults
APP_PORT=3000
APP2_PORT=3001
APP3_PORT=3002
LOCALSTACK_PORT=4566
POSTGRES_PASSWORD=local-admin
APP_DATABASE_PASSWORD=local-app
MIGRATION_DATABASE_PASSWORD=local-migrator

# Dev mode database (local `bun start`)
DATABASE_URL=postgresql://wager_app:local-app@localhost:5432/wagering
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_TRANSACTION_TIMEOUT_MS=5000
DATABASE_TRANSACTION_MAX_ATTEMPTS=3
DATABASE_RETRY_BASE_DELAY_MS=25
DATABASE_RETRY_MAX_DELAY_MS=250

# Pending-reference demo limits; review TTL, attempts and backoff for production.
PENDING_REFERENCE_TTL_MS=300000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_RETRY_BASE_MS=1000
PENDING_REFERENCE_RETRY_MAX_MS=30000

# Host-side SQS access; Compose uses its internal LocalStack hostname.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_IN_FLIGHT=4
SQS_REQUEST_TIMEOUT_MS=5000

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
OUTBOX_ESCALATE_AFTER_ATTEMPTS=10

PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_LEASE_MS=30000

SQS_RETRY_BASE_SECONDS=1
SQS_RETRY_MAX_SECONDS=30
# Queue maxReceiveCount=5 and DLQ retention=14 days are configured in docker/localstack.
