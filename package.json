{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "typecheck": "tsc --noEmit",
    "test:smoke": "bun test test/smoke",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "bun tooling/format.mjs",
    "format:check": "bun tooling/format.mjs --check",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "test": "bun test ./test/unit ./test/smoke",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration",
    "test:concurrency": "bun test ./test/concurrency",
    "test:recovery": "bun test ./test/recovery",
    "test:all": "bun run test && bun run test:integration && bun run test:concurrency && bun run test:recovery",
    "verify": "bun run check && bun run build && bun run test:all",
    "migration:up": "docker compose run --rm migrations update",
    "migration:down": "docker compose run --rm migrations rollback-count --count=1",
    "migration:status": "docker compose run --rm migrations status --verbose",
    "infra:up": "docker compose up --detach --wait postgres && docker compose run --rm queue-init",
    "queue:init": "docker compose run --rm queue-init",
    "app:up": "docker compose up --build app app2 app3",
    "dev:up": "docker compose up --build",
    "dev:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1152.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "decimal.js": "10.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.3",
    "@types/bun": "1.4.3",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsc-alias": "1.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
